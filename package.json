{
  "name": "cargill-custom-apps-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Cargill Custom Apps (payment processing)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --import ./test/setup-env.ts --test \"test/**/*.test.ts\"",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../database/postgres/tests/test_integrations.sql",
    "mock:sap": "tsx scripts/mock-sap/start.ts",
    "mock:onbase": "tsx scripts/mock-onbase/start.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

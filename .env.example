# Server
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL - e.g. Supabase: Project Settings > Database > Connection string (Session pooler)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
# Quote the value when it contains # or spaces
DB_PASSWORD="change-me"
# disable | require (encrypted, certificate not verified) | verify-full (set DB_SSL_CA)
DB_SSL=require
# DB_SSL_CA=certs/supabase-ca.crt
# Keep small on Supabase: the session pooler limits connections per project
DB_POOL_MAX=5

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
# Secret used to sign short-lived attachment download URLs
FILE_URL_SECRET=replace-with-another-long-random-string
FILE_URL_TTL_SECONDS=900

# Folder holding invoice attachment files (relative to backend/)
STORAGE_DIR=storage/attachments

# ---- Invoice integrations (Settings > SAP Configuration) ----
# 32-byte key (base64) encrypting SAP credentials:  openssl rand -base64 32
# Without it the app runs, but credentials cannot be stored. Rotate by moving the old key to
# INTEGRATION_SECRET_KEY_PREVIOUS (comma separated) and setting a new one.
INTEGRATION_SECRET_KEY=
# INTEGRATION_SECRET_KEY_PREVIOUS=
# Optional allow-list of SAP / token hosts (exact or *.suffix), e.g. *.s4hana.cloud.sap,sap.cargill.com
INTEGRATION_ALLOWED_HOSTS=
# Run scheduler + worker inside the API process (set false when `npm run worker` runs as its own container)
SYNC_WORKER_ENABLED=true
SYNC_POLL_INTERVAL_SECONDS=10
SYNC_SCHEDULER_INTERVAL_SECONDS=30
SYNC_JOB_STALE_SECONDS=300
SYNC_HISTORY_RETENTION_DAYS=90
# Extra CA certificates for SAP endpoints signed by a corporate CA (PEM file):
# NODE_EXTRA_CA_CERTS=certs/corporate-ca.pem

# ---- Email inbox (Microsoft Graph, app-only; needs the Mail.Read application permission) ----
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox used by the scripts/try-* diagnostics (the poller reads the mailboxes in app.mailboxes)
MAILBOX_ADDRESS=
# Poll the registered mailboxes in the process that runs background work (API with SYNC_WORKER_ENABLED, or the worker)
MAILBOX_POLLING_ENABLED=false
MAILBOX_POLL_INTERVAL_SECONDS=120

# ---- Attachment storage (invoice PDFs) - see docs/STORAGE.md ----
# local = STORAGE_DIR (default) | s3 = Amazon S3 / S3-compatible bucket
STORAGE_PROVIDER=local
# Bucket names are lower case: letters, digits, dots, hyphens
S3_BUCKET=latam-invoice-attachments
S3_REGION=us-east-1
# Leave empty to use the AWS default credential chain (IAM role, profile, SSO) - preferred in AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Custom endpoint for S3-compatible stores / local mock (npm run mock:s3 -> http://localhost:4030)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Layout: <bucket>/[S3_PREFIX/]<App>/<YYYY>/<Mon>/<file name>
S3_PREFIX=
S3_APP_FOLDERS=GP:GPP,sjo:SJO,rospbu:ROSPBU
STORAGE_FOLDER_TIMEZONE=UTC
# Server-side encryption: none | AES256 | aws:kms (+ S3_KMS_KEY_ID)
S3_SSE=AES256
S3_KMS_KEY_ID=
S3_MAX_ATTEMPTS=4
S3_RETRY_BASE_DELAY_MS=200
S3_CONNECT_TIMEOUT_MS=5000
S3_REQUEST_TIMEOUT_MS=60000
STORAGE_MAX_FILE_MB=50
